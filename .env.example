# Database (local dev — use docker-compose)
DATABASE_URL=postgres://ericoid_user:ericoid_password@localhost:5433/ericoid_db?sslmode=disable
POSTGRES_USER=ericoid_user
POSTGRES_PASSWORD=ericoid_password
POSTGRES_DB=ericoid_db

# Redis (local dev)
REDIS_URL=redis://localhost:6380

# SMTP (for OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@eri.co.id

# JWT
JWT_SECRET=your-secret-key-min-32-chars-long
REFRESH_TOKEN_SECRET=your-refresh-secret-key-long

# App
PORT=8080
ENVIRONMENT=development

# Bootstrap: creates the first super_admin on boot if none exists yet (idempotent)
SUPER_ADMIN_EMAIL=admin@eri.co.id
SUPER_ADMIN_NAME=Super Admin

# File uploads: local disk for now (no Garage/S3 credentials configured yet)
UPLOAD_DIR=./uploads
